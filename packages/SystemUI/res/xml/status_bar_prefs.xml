<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:sysui="http://schemas.android.com/apk/res-auto"
    android:key="status_bar"
    android:title="@string/status_bar">

    <com.android.systemui.tuner.FeaturedThemePreference
        android:key="system_icon_packs"
        android:layout="@layout/preference_icon_packs_card"
        android:persistent="false"
        android:summary="@string/status_bar_icon_packs_summary"
        android:title="@string/status_bar_icon_packs_title"
        sysui:featuredActionText="@string/status_bar_icon_packs_action"
        sysui:featuredPreviewIcon1="@drawable/ic_tuner_statusbar_wifi"
        sysui:featuredPreviewIcon2="@drawable/ic_tuner_statusbar_bluetooth"
        sysui:featuredPreviewIcon3="@drawable/ic_tuner_statusbar_battery"
        sysui:featuredPreviewIcon4="@drawable/ic_tuner_statusbar_alarm"
        sysui:singleLineTitle="false">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.axion.axthemestore.MainActivity"
            android:targetPackage="com.android.axion.axthemestore">
            <extra
                android:name="com.android.axion.axthemestore.extra.STORE_SECTION"
                android:value="icon_packs" />
        </intent>
    </com.android.systemui.tuner.FeaturedThemePreference>

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_auto_rotate"
        android:key="rotate"
        android:title="@string/status_bar_settings_auto_rotation" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_headset"
        android:key="headset"
        android:title="@string/headset" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_statusbar_firewall"
        android:key="firewall"
        android:title="@string/status_bar_firewall" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_work"
        android:key="managed_profile"
        android:title="@string/status_bar_work" />

    <!-- ime -->
    <!-- sync_failing -->
    <!-- sync_active -->

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_cast"
        android:key="cast"
        android:title="@string/quick_settings_cast_title" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_hotspot"
        android:key="hotspot"
        android:title="@string/quick_settings_hotspot_label" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_bluetooth"
        android:key="bluetooth"
        android:title="@string/quick_settings_bluetooth_label" />

    <com.android.systemui.tuner.TunerSwitch
        android:icon="@drawable/ic_tuner_statusbar_bluetooth"
        android:key="system:bluetooth_battery_level"
        android:title="@string/status_bar_bluetooth_battery_level"
        sysui:defValue="true" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_camera"
        android:key="cameratoggle"
        android:title="@string/quick_settings_camera_label" />

    <!-- nfc -->
    <!-- tty -->
    <!-- speakerphone -->

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_do_not_disturb"
        android:key="zen"
        android:title="@string/quick_settings_dnd_label" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_mute"
        android:key="mute"
        android:title="@string/volume_ringer_status_silent" />

    <com.android.systemui.tuner.TunerSwitch
        android:key="status_bar_show_vibrate_icon"
        android:title="@string/volume_ringer_status_vibrate"
        android:icon="@drawable/ic_tuner_statusbar_vibrate"
        sysui:defValue="true" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/outline_speed_24"
        android:key="network_speed"
        android:title="@string/status_bar_settings_network_speed" />

    <!-- other weird signal stuff -->

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_vpn"
        android:key="vpn"
        android:title="@string/legacy_vpn_name" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_battery"
        android:key="battery"
        android:title="@string/battery" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:title="@string/status_bar_nfc"
        android:key="nfc"
        android:icon="@drawable/ic_statusbar_nfc" />

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_alarm"
        android:key="alarm_clock"
        android:title="@string/status_bar_alarm" />

    <!-- secure -->

    <com.android.systemui.tuner.StatusBarSwitch
        android:icon="@drawable/ic_tuner_statusbar_clock"
        android:key="clock"
        android:title="@string/clock" />

    <com.android.systemui.tuner.TunerSwitch
        android:icon="@drawable/ic_statusbar_mic"
        android:key="mic_camera_privacy_indicators_enabled"
        android:title="@string/mic_camera_privacy_indicator_title"
        sysui:defValue="true" />

    <com.android.systemui.tuner.TunerSwitch
        android:icon="@drawable/ic_statusbar_location"
        android:key="location_privacy_indicator_enabled"
        android:title="@string/location_privacy_indicator_title"
        sysui:defValue="true" />

    <com.android.systemui.tuner.TunerSwitch
        android:icon="@drawable/ic_tuner_statusbar_cast"
        android:key="enable_projection_privacy_indicator"
        android:title="@string/projection_privacy_indicator_title"
        sysui:defValue="true" />

    <com.android.systemui.tuner.TunerSwitch
        android:icon="@drawable/ic_statusbar_priority"
        android:key="low_priority"
        android:title="@string/tuner_low_priority"
        sysui:defValue="false" />

    <androidx.preference.PreferenceCategory
        android:key="network_icons_category"
        android:title="@string/status_bar_network_icons_category_title">

        <com.android.systemui.tuner.FeaturedThemePreference
            android:key="custom_system_theme"
            android:layout="@layout/preference_icon_packs_card"
            android:persistent="false"
            android:summary="@string/custom_system_theme_summary"
            android:title="@string/custom_system_theme_title"
            sysui:featuredActionText="@string/status_bar_network_icon_themes_action"
            sysui:featuredPreviewIcon1="@drawable/ic_tuner_statusbar_wifi"
            sysui:featuredPreviewIcon2="@drawable/ic_tuner_statusbar_mobile_network"
            sysui:featuredPreviewIcon3="@drawable/ic_tuner_statusbar_ethernet"
            sysui:featuredPreviewIcon4="@drawable/ic_tuner_statusbar_airplanemode"
            sysui:singleLineTitle="false">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.axion.axthemestore.MainActivity"
                android:targetPackage="com.android.axion.axthemestore">
                <extra
                    android:name="com.android.axion.axthemestore.extra.STORE_SECTION"
                    android:value="network_icons" />
            </intent>
        </com.android.systemui.tuner.FeaturedThemePreference>

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_tuner_statusbar_wifi"
            android:key="wifi"
            android:title="@string/quick_settings_wifi_label" />

        <com.android.systemui.tuner.TunerSwitch
            android:icon="@drawable/ic_statusbar_wifi_standard"
            android:key="show_wifi_standard_icon"
            android:title="@string/status_bar_wifi_standard"
            sysui:defValue="false" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_tuner_statusbar_ethernet"
            android:key="ethernet"
            android:title="@string/status_bar_ethernet" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_tuner_statusbar_mobile_network"
            android:key="mobile"
            android:title="@string/quick_settings_cellular_detail_title" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_tuner_statusbar_airplanemode"
            android:key="airplane"
            android:title="@string/status_bar_airplane" />

        <com.android.systemui.tuner.TunerSwitch
            android:icon="@drawable/ic_settings_lte_to_4g"
            android:key="system:show_fourg_icon"
            android:title="@string/show_fourg_icon_title"
            sysui:defValue="false" />

        <com.android.systemui.tuner.TunerSwitch
            android:icon="@drawable/ic_statusbar_data_disabled"
            android:key="system:data_disabled_icon"
            android:title="@string/data_disabled_icon_title"
            sysui:defValue="true" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_statusbar_roaming"
            android:key="roaming"
            android:title="@string/status_bar_roaming" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="ims_status_bar_category"
        android:title="@string/status_bar_ims_indicator_category_title">

        <androidx.preference.ListPreference
            android:key="status_bar_ims_indicator_style"
            android:title="@string/status_bar_ims_indicator_style_title"
            android:dialogTitle="@string/status_bar_ims_indicator_style_title"
            android:summary="%s"
            android:icon="@drawable/ic_statusbar_hd_calling"
            android:entries="@array/status_bar_ims_indicator_style_entries"
            android:entryValues="@array/status_bar_ims_indicator_style_values" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_statusbar_hd_calling"
            android:key="hd_calling"
            android:title="@string/status_bar_hd_calling" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_statusbar_vowifi"
            android:key="vowifi"
            android:title="@string/status_bar_vowifi" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_statusbar_volte_tuner"
            android:key="volte"
            android:title="@string/status_bar_volte_icon_title" />

        <com.android.systemui.tuner.StatusBarSwitch
            android:icon="@drawable/ic_statusbar_vonr_tuner"
            android:key="vonr"
            android:title="@string/status_bar_vonr_icon_title" />
    </androidx.preference.PreferenceCategory>

</PreferenceScreen>
