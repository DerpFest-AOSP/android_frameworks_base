-include ../../../proguard_kotlin.flags

-keepattributes Signature
-keepclassmembers class com.android.systemui.clocks.sample.R$* { public static <fields>; }

# If we don't keep these compose methods than proguard becomes confused and assumes null return
# values where it should not. This can cause an NPE or other exception at runtime.
-keep !enum androidx.compose.**Scope { *; }
-keep !enum androidx.compose.runtime.** {
    *** startRestartGroup(...);
    *** getApplier(...);
}

# Same classloader-boundary issue as DefaultClockFaceLayout: keep scene-container
# element keys so R8 does not stub getKey() to null.
-keep class * implements com.android.systemui.plugins.keyguard.ui.composable.elements.BaseLockscreenElement { *; }
-keep class * implements com.android.systemui.plugins.keyguard.ui.composable.elements.LockscreenElement { *; }
-keep class * implements com.android.systemui.plugins.keyguard.ui.composable.elements.MovableLockscreenElement { *; }
